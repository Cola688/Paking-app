.container { min-height: 100vh; background: #f5f5f5; padding: calc(20rpx + 88rpx) 30rpx 20rpx; }
.car-list { display: flex; flex-direction: column; gap: 20rpx; margin-bottom: 40rpx; }
.car-item { background: #fff; padding: 30rpx; border-radius: 12rpx; display: flex; justify-content: space-between; align-items: center; }
.car-plate { font-size: 36rpx; font-weight: bold; color: #333; margin-bottom: 8rpx; }
.car-type { font-size: 24rpx; color: #666; }
.car-action { color: #1989fa; font-size: 28rpx; }
.add-btn { background: #1989fa; color: #fff; border-radius: 44rpx; height: 88rpx; line-height: 88rpx; }
