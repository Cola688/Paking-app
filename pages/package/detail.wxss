.container {
  min-height: 100vh;
  padding-bottom: 150rpx;
  background: #f4f7fb;
}

.loading {
  padding: 120rpx 0;
  text-align: center;
  color: #94a3b8;
  font-size: 28rpx;
}

.hero-card {
  margin: 24rpx 30rpx 0;
  padding: 34rpx;
  border-radius: 20rpx;
  background: #001f80;
  color: #fff;
  box-shadow: 0 12rpx 30rpx rgba(0, 31, 128, 0.18);
}

.hero-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.product-type,
.owned-tag {
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.16);
  font-size: 24rpx;
}

.product-name {
  display: block;
  margin-top: 26rpx;
  font-size: 40rpx;
  font-weight: 700;
}

.price {
  display: block;
  margin-top: 20rpx;
  color: #ffd38a;
  font-size: 44rpx;
  font-weight: 700;
}

.desc {
  display: block;
  margin-top: 18rpx;
  color: rgba(255, 255, 255, 0.84);
  font-size: 26rpx;
  line-height: 1.5;
}

.rules-grid {
  margin: 22rpx 30rpx 0;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
}

.rule-item {
  padding: 24rpx 12rpx;
  border-radius: 14rpx;
  background: #fff;
  text-align: center;
  box-shadow: 0 8rpx 22rpx rgba(15, 23, 42, 0.05);
}

.rule-value {
  display: block;
  color: #001f80;
  font-size: 34rpx;
  font-weight: 700;
}

.rule-label {
  display: block;
  margin-top: 8rpx;
  color: #64748b;
  font-size: 22rpx;
}

.lot-section {
  margin: 26rpx 30rpx 0;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 18rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #111827;
}

.section-count {
  font-size: 24rpx;
  color: #64748b;
}

.lot-card {
  margin-bottom: 18rpx;
  padding: 24rpx;
  border-radius: 16rpx;
  background: #fff;
  display: flex;
  gap: 20rpx;
  border: 2rpx solid transparent;
  box-shadow: 0 8rpx 22rpx rgba(15, 23, 42, 0.05);
}

.lot-card.checked {
  border-color: #1677ff;
  background: #f8fbff;
}

.check-dot {
  width: 42rpx;
  height: 42rpx;
  border-radius: 50%;
  border: 2rpx solid #cbd5e1;
  color: #1677ff;
  font-size: 28rpx;
  line-height: 42rpx;
  text-align: center;
  flex-shrink: 0;
}

.lot-card.checked .check-dot {
  border-color: #1677ff;
  background: #e8f3ff;
}

.lot-main {
  min-width: 0;
  flex: 1;
}

.lot-name {
  display: block;
  color: #111827;
  font-size: 30rpx;
  font-weight: 700;
}

.lot-location,
.lot-meta {
  display: block;
  margin-top: 10rpx;
  color: #64748b;
  font-size: 24rpx;
  line-height: 1.4;
}

.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 20rpx 30rpx calc(20rpx + env(safe-area-inset-bottom));
  background: #fff;
  box-shadow: 0 -8rpx 24rpx rgba(15, 23, 42, 0.08);
}

.confirm-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  line-height: normal;
  border-radius: 999rpx;
  background: #001f80;
  color: #fff;
  font-size: 30rpx;
  font-weight: 700;
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

.confirm-btn::after {
  border: none;
}
