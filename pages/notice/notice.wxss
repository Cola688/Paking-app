.container {
  min-height: 100vh;
  background: #f5f5f5;
}

/* 通知列表 */
.notice-list {
  padding: 20rpx 30rpx;
}

.notice-item {
  display: flex;
  align-items: flex-start;
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  position: relative;
}

.notice-item.read {
  opacity: 0.7;
}

/* 通知图标 */
.notice-icon-wrap {
  width: 80rpx;
  height: 80rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-right: 24rpx;
}

.notice-icon-wrap.system {
  background: #e6f4ff;
}

.notice-icon-wrap.order {
  background: #fff7e6;
}

.notice-icon-wrap.promo {
  background: #f6ffed;
}

.notice-icon-text {
  font-size: 36rpx;
  font-weight: bold;
}

.notice-icon-wrap.system .notice-icon-text {
  color: #1890ff;
}

.notice-icon-wrap.order .notice-icon-text {
  color: #fa8c16;
}

.notice-icon-wrap.promo .notice-icon-text {
  color: #52c41a;
}

/* 通知内容 */
.notice-content {
  flex: 1;
}

.notice-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.notice-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a1a;
}

.notice-time {
  font-size: 24rpx;
  color: #999;
}

.notice-desc {
  font-size: 26rpx;
  color: #666;
  line-height: 1.5;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

/* 未读红点 */
.unread-dot {
  position: absolute;
  top: 36rpx;
  right: 36rpx;
  width: 16rpx;
  height: 16rpx;
  background: #ff4d4f;
  border-radius: 50%;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 200rpx 0;
}

.empty-icon {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 30rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
}

/* 底部清空按钮 */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20rpx 30rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: #fff;
  box-shadow: 0 -2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.clear-btn {
  text-align: center;
  font-size: 28rpx;
  color: #ff4d4f;
  padding: 20rpx 0;
}
