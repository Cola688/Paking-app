<view class="container">
  <navbar title="我的优惠券" />

  <view class="coupon-list">
    <view class="coupon-item {{item.status}}" wx:for="{{coupons}}" wx:key="id">
      <view class="coupon-left">
        <view class="coupon-value">¥<text>{{item.value}}</text></view>
        <view class="coupon-condition">{{item.condition}}</view>
      </view>
      <view class="coupon-right">
        <view class="coupon-name">{{item.name}}</view>
        <view class="coupon-expire">有效期至 {{item.expireDate}}</view>
        <view class="coupon-btn" wx:if="{{item.status === 'available'}}">立即使用</view>
        <view class="coupon-btn used" wx:if="{{item.status === 'used'}}">已使用</view>
        <view class="coupon-btn expired" wx:if="{{item.status === 'expired'}}">已过期</view>
      </view>
    </view>
  </view>
</view>
