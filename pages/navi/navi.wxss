.container {
  min-height: 100vh;
  background: #f5f5f5;
}

.map-section {
  height: calc(100vh - 88rpx);
}

.navi-map {
  width: 100%;
  height: 100%;
}

.destination-card {
  background: #fff;
  padding: 30rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.dest-info {
  flex: 1;
}

.dest-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 8rpx;
}

.dest-address {
  font-size: 26rpx;
  color: #666;
}

.dest-distance {
  font-size: 28rpx;
  color: #1989fa;
}

.action-section {
  padding: 40rpx 30rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.action-btn {
  background: #1989fa;
  color: #fff;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 44rpx;
  font-size: 32rpx;
}

.action-btn.secondary {
  background: #fff;
  color: #1989fa;
  border: 2rpx solid #1989fa;
}
