<view class="container">
  <navbar title="忘记密码" showBack />

  <view class="content">
    <view class="header-section">
      <text class="welcome-text">重置密码</text>
      <text class="desc-text">请输入您的手机号和验证码</text>
    </view>

    <view class="form-section">
      <view class="input-group">
        <text class="input-label">手机号</text>
        <input class="input-item" type="number" maxlength="11" placeholder="请输入注册手机号" value="{{phone}}" bindinput="onPhoneInput" />
      </view>

      <view class="input-group">
        <text class="input-label">验证码</text>
        <view class="code-wrap">
          <input class="input-item code-input" type="number" maxlength="6" placeholder="请输入验证码" value="{{code}}" bindinput="onCodeInput" />
          <button class="get-code-btn" bindtap="getCode" disabled="{{codeDisabled}}">{{codeText}}</button>
        </view>
      </view>

      <view class="input-group">
        <text class="input-label">新密码</text>
        <input class="input-item" password placeholder="请输入新密码(6-20位)" value="{{password}}" bindinput="onPasswordInput" />
      </view>

      <view class="input-group">
        <text class="input-label">确认密码</text>
        <input class="input-item" password placeholder="请再次输入新密码" value="{{confirmPassword}}" bindinput="onConfirmPasswordInput" />
      </view>

      <button class="submit-btn" bindtap="handleSubmit">确认修改</button>
    </view>

    <view class="login-tip">
      <text>想起密码了？</text>
      <text class="login-link" bindtap="goLogin">立即登录</text>
    </view>
  </view>

  <view class="copyright">
    Copyright © 2025 共和新路街道停车联盟
  </view>
</view>
