<view class="container">
  <navbar title="注册" showBack />

  <view class="content">
    <view class="header-section">
      <image class="header-img" src="/images/logo.png" mode="aspectFit"></image>
      <text class="welcome-text">欢迎注册</text>
      <text class="desc-text">共和新路街道停车联盟</text>
    </view>

    <!-- 联盟优势 -->
    <view class="benefits-section">
      <view class="benefits-title">为什么选择停车联盟？</view>
      <view class="benefits-list">
        <view class="benefit-card">
          <view class="benefit-icon">📅</view>
          <view class="benefit-info">
            <text class="benefit-name">包月预约</text>
            <text class="benefit-desc">支持按月预约车位，无需每天抢位，停车更省心</text>
          </view>
        </view>
        <view class="benefit-card">
          <view class="benefit-icon">📍</view>
          <view class="benefit-info">
            <text class="benefit-name">车位实时查询</text>
            <text class="benefit-desc">街道内停车场车位情况一目了然，收费标准公开透明</text>
          </view>
        </view>
        <view class="benefit-card">
          <view class="benefit-icon">💰</view>
          <view class="benefit-info">
            <text class="benefit-name">停车优惠</text>
            <text class="benefit-desc">联盟会员享受停车费用优惠，错峰停车更实惠</text>
          </view>
        </view>
      </view>
    </view>

    <view class="form-section">
      <view class="input-group">
        <text class="input-label">手机号</text>
        <input class="input-item" type="number" maxlength="11" placeholder="请输入手机号" value="{{phone}}" bindinput="onPhoneInput" />
      </view>

      <view class="input-group">
        <text class="input-label">验证码</text>
        <view class="code-wrap">
          <input class="input-item code-input" type="number" maxlength="6" placeholder="请输入验证码" value="{{code}}" bindinput="onCodeInput" />
          <button class="get-code-btn" bindtap="getCode" disabled="{{codeDisabled}}">{{codeText}}</button>
        </view>
      </view>

      <view class="input-group">
        <text class="input-label">设置密码</text>
        <view class="password-wrap">
          <input class="input-item" password placeholder="请设置登录密码(6-20位)" value="{{password}}" bindinput="onPasswordInput" />
        </view>
      </view>

      <view class="input-group">
        <text class="input-label">确认密码</text>
        <view class="password-wrap">
          <input class="input-item" password placeholder="请再次输入密码" value="{{confirmPassword}}" bindinput="onConfirmPasswordInput" />
        </view>
      </view>

      <!-- 协议 -->
      <view class="agreement-section">
        <checkbox-group bindchange="onAgreementChange">
          <label class="agreement-label">
            <checkbox value="agree" checked="{{agreed}}" color="#001f80" />
            <text class="agreement-text">我已阅读并同意</text>
          </label>
        </checkbox-group>
        <text class="agreement-link" bindtap="showAgreement">《用户服务协议》</text>
        <text class="agreement-text">和</text>
        <text class="agreement-link" bindtap="showPrivacy">《隐私政策》</text>
      </view>

      <button class="register-btn" bindtap="handleRegister">注册</button>
    </view>

    <!-- 登录入口 -->
    <view class="login-tip">
      <text>已有账号？</text>
      <text class="login-link" bindtap="goLogin">立即登录</text>
    </view>
  </view>

  <view class="copyright">
    Copyright © 2025 共和新路街道停车联盟
  </view>
</view>
