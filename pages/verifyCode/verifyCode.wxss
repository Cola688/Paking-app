page {
  background-color: #f5f5f5;
  height: 100vh;
}

.container {
  width: 100%;
  background-color: #fff;
  min-height: 100vh;
}

.nav-bar {
  background-color: #001f80;
  color: #fff;
  height: 88rpx;
  display: flex;
  align-items: center;
  padding: 0 30rpx;
}

.nav-icon image {
  width: 50rpx;
  height: 50rpx;
}

.nav-placeholder {
  width: 50rpx;
}

.nav-title {
  flex: 1;
  text-align: center;
  font-size: 34rpx;
  font-weight: 500;
}

.content {
  padding: 100rpx 40rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.header-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 80rpx;
}

.desc-text {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 20rpx;
}

.phone-text {
  font-size: 36rpx;
  font-weight: 600;
  color: #333;
}

.code-section {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.code-input-wrap {
  display: flex;
  justify-content: center;
  gap: 20rpx;
  margin-bottom: 40rpx;
}

.code-input-item {
  width: 100rpx;
  height: 100rpx;
  background-color: #f5f5f5;
  border-radius: 16rpx;
  border: 2rpx solid #e0e0e0;
  text-align: center;
  font-size: 48rpx;
  font-weight: 600;
  color: #333;
}

.code-input-item.active {
  border-color: #001f80;
  background-color: #fff;
}

.resend-wrap {
  display: flex;
  justify-content: center;
}

.resend-text {
  font-size: 28rpx;
  color: #999;
}

.resend-btn {
  font-size: 28rpx;
  color: #001f80;
}

.resend-btn.disabled {
  color: #999;
}
