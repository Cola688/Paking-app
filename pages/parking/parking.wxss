.container {
  min-height: 100vh;
  background: #f5f5f5;
  padding: calc(30rpx + 88rpx) 30rpx 30rpx;
}

.status-card {
  background: linear-gradient(135deg, #1989fa 0%, #007aff 100%);
  border-radius: 20rpx;
  padding: 60rpx 40rpx;
  display: flex;
  align-items: center;
  margin-bottom: 30rpx;
}

.status-icon {
  width: 120rpx;
  height: 120rpx;
  background: rgba(255,255,255,0.2);
  border-radius: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 30rpx;
}

.status-icon image {
  width: 60rpx;
  height: 60rpx;
}

.status-icon.active {
  background: #fff;
}

.status-text {
  color: #fff;
}

.status-label {
  font-size: 36rpx;
  font-weight: bold;
  display: block;
  margin-bottom: 8rpx;
}

.status-time {
  font-size: 28rpx;
  opacity: 0.9;
}

.info-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
}

.info-row {
  display: flex;
  justify-content: space-between;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.info-row:last-child {
  border-bottom: none;
}

.label {
  font-size: 28rpx;
  color: #666;
}

.value {
  font-size: 28rpx;
  color: #333;
}

.value.price {
  color: #ff6b35;
  font-weight: bold;
}

.action-bar {
  margin-top: 40rpx;
  display: flex;
  justify-content: center;
}

.btn {
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 44rpx;
  font-size: 32rpx;
  min-width: 500rpx;
}

.btn-primary {
  background: #1989fa;
  color: #fff;
}

.btn-outline {
  background: #fff;
  color: #1989fa;
  border: 2rpx solid #1989fa;
}
