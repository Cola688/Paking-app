.container {
  padding: 0;
  min-height: 100vh;
  background: #f5f5f5;
}

/* 搜索栏区域 */
.search-area {
  display: flex;
  align-items: center;
  padding: 20rpx 30rpx;
  background: #fff;
}

.search-bar {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f5f5f5;
  padding: 20rpx 30rpx;
  border-radius: 60rpx;
}

.search-icon {
  width: 36rpx;
  height: 36rpx;
  margin-right: 16rpx;
}

.search-placeholder {
  font-size: 28rpx;
  color: #999;
}

.notice-btn {
  position: relative;
  margin-left: 20rpx;
  padding: 10rpx;
}

.notice-icon {
  width: 44rpx;
  height: 44rpx;
}

.notice-badge {
  position: absolute;
  top: 0rpx;
  right: -4rpx;
  min-width: 32rpx;
  height: 32rpx;
  background: #ff4d4f;
  border-radius: 16rpx;
  font-size: 20rpx;
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 8rpx;
}

.map {
  width: 100%;
  height: 500rpx;
  margin-top: 20rpx;
}

.location-bar {
  display: flex;
  align-items: center;
  margin: 16rpx 30rpx 0;
  padding: 18rpx 24rpx;
  background: #fff;
  border-radius: 12rpx;
  box-shadow: 0 4rpx 18rpx rgba(0, 31, 128, 0.08);
}

.location-dot {
  width: 14rpx;
  height: 14rpx;
  margin-right: 14rpx;
  background: #1677ff;
  border: 4rpx solid rgba(22, 119, 255, 0.18);
  border-radius: 50%;
}

.location-text {
  flex: 1;
  overflow: hidden;
  color: #333;
  font-size: 26rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.map-entry {
  margin: 20rpx 30rpx 0;
  padding: 24rpx 28rpx;
  border-radius: 16rpx;
  background: #fff;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-shadow: 0 4rpx 18rpx rgba(0, 31, 128, 0.08);
}

.map-entry-main {
  display: flex;
  flex-direction: column;
}

.map-entry-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a1a;
}

.map-entry-desc {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #777;
}

.map-entry-arrow {
  font-size: 48rpx;
  color: #001f80;
}

.nearby-section {
  background: #fff;
  margin-top: 20rpx;
  padding: 30rpx;
}

.section-header {
  margin-bottom: 30rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
}

.parking-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.parking-loading,
.parking-empty {
  padding: 48rpx 0;
  color: #999;
  font-size: 28rpx;
  text-align: center;
}

/* 卡片整体 */
.parking-card {
  background: #fff;
  border-radius: 12rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
  border-left: 6rpx solid #001f80;
}

/* 头部：名称+地址+图片 */
.card-header {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
}

.info-main {
  flex: 1;
  min-width: 0;
}

.name-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-bottom: 16rpx;
}

.parking-name {
  flex: 1;
  font-size: 32rpx;
  font-weight: 600;
  color: #1a1a1a;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.distance-text {
  flex-shrink: 0;
  align-self: flex-start;
  color: #245d9f;
  font-size: 22rpx;
  font-weight: 600;
  white-space: nowrap;
}

.status-tag {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  min-width: 72rpx;
  height: 40rpx;
  box-sizing: border-box;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 40rpx;
  padding: 0 14rpx;
  border-radius: 999rpx;
  white-space: nowrap;
}
.status-tag.available {
  background: #e9f8f1;
  color: #15995f;
}
.status-tag.busy {
  background: #fff2f0;
  color: #ff4d4f;
}

.address-row {
  display: flex;
  align-items: center;
  font-size: 28rpx;
  color: #666;
}

.location-icon {
  width: 28rpx;
  height: 28rpx;
  margin-right: 8rpx;
}

.parking-img {
  width: 160rpx;
  height: 120rpx;
  border-radius: 8rpx;
  flex-shrink: 0;
}

/* 分割线 */
.divider {
  height: 1rpx;
  background: #eee;
  margin: 20rpx 0;
}

/* 底部：价格+车位+按钮 */
.card-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 20rpx;
}

.detail-info {
  display: flex;
  align-items: center;
  flex: 1;
  min-width: 0;
  flex-wrap: wrap;
  gap: 12rpx 18rpx;
}

.price {
  font-size: 30rpx;
  font-weight: 600;
  color: #0066ff;
  margin-right: 0;
  white-space: nowrap;
}

.space-count {
  max-width: 100%;
  box-sizing: border-box;
  padding: 7rpx 14rpx;
  border-radius: 999rpx;
  background: #f0faf5;
  color: #15995f;
  font-size: 24rpx;
  font-weight: 600;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.go-btn {
  background: #004499;
  color: #fff;
  border-radius: 40rpx;
  font-size: 24rpx;
  padding: 20rpx 16rpx;
  border: none;
  line-height: 1;
  min-width: 160rpx;
  max-width: 180rpx;
  text-align: center;
  flex-shrink: 0;
  white-space: nowrap;
}
