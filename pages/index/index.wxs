var zoomSpeed = 0.1

module.exports = {
  calculateZoom: function(currentZoom, touchDistance, startDistance, startZoom, minZoom, maxZoom) {
    var scale = touchDistance / startDistance
    var newZoom = startZoom * scale
    return Math.min(Math.max(newZoom, minZoom), maxZoom)
  },
  calculateOffset: function(offsetX, offsetY, deltaX, deltaY, zoom) {
    return {
      offsetX: offsetX - deltaX / zoom,
      offsetY: offsetY + deltaY / zoom
    }
  },
  worldToScreen: function(worldX, worldY, cameraX, cameraY, halfWidth, halfHeight, screenWidth, screenHeight) {
    var screenX = ((worldX - cameraX + halfWidth) / (2 * halfWidth)) * screenWidth
    var screenY = ((halfHeight - (worldY - cameraY)) / (2 * halfHeight)) * screenHeight
    return { x: screenX, y: screenY }
  },
  getViewBounds: function(zoom, aspectRatio) {
    var halfHeight = 5 / zoom
    var halfWidth = halfHeight * aspectRatio
    return { halfWidth: halfWidth, halfHeight: halfHeight }
  },
  lerp: function(current, target, factor) {
    return current + (target - current) * factor
  }
}
