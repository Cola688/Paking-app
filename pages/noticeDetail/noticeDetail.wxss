.container {
  min-height: 100vh;
  background: #f5f5f5;
  padding: calc(20rpx + 88rpx) 30rpx 40rpx;
  box-sizing: border-box;
}

.detail {
  background: #fff;
  border-radius: 16rpx;
  padding: 34rpx 30rpx;
}

.type-row {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.type-dot {
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  background: #1890ff;
  margin-right: 12rpx;
}

.type-dot.order {
  background: #fa8c16;
}

.type-dot.promo {
  background: #52c41a;
}

.type-dot.parking,
.type-dot.pass {
  background: #001f80;
}

.type-text {
  font-size: 24rpx;
  color: #666;
}

.title {
  font-size: 38rpx;
  font-weight: 700;
  color: #1a1a1a;
  line-height: 1.35;
}

.time {
  margin-top: 18rpx;
  font-size: 24rpx;
  color: #999;
}

.content {
  margin-top: 34rpx;
  font-size: 30rpx;
  color: #333;
  line-height: 1.75;
  white-space: pre-wrap;
}

.action-btn {
  margin-top: 48rpx;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 44rpx;
  text-align: center;
  color: #fff;
  font-size: 30rpx;
  background: #001f80;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 200rpx 0;
}

.empty-icon {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 30rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
}
