.container { min-height: 100vh; background: #f5f5f5; padding: calc(20rpx + 88rpx) 30rpx 20rpx; }
.help-item { background: #fff; border-radius: 12rpx; margin-bottom: 20rpx; overflow: hidden; }
.help-q { padding: 30rpx; display: flex; justify-content: space-between; font-size: 28rpx; color: #333; }
.help-a { padding: 0 30rpx 30rpx; font-size: 26rpx; color: #666; line-height: 1.6; }
.arrow { color: #ccc; transition: transform 0.3s; }
.arrow.open { transform: rotate(180deg); }
