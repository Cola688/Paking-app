.container {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: 140rpx;
}

.header {
  background: #fff;
  padding: 30rpx;
}

.parking-name {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 12rpx;
}

.parking-address {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 20rpx;
}

.parking-tags {
  display: flex;
  gap: 12rpx;
}

.tag {
  font-size: 22rpx;
  color: #ff6b35;
  background: #fff2e8;
  padding: 6rpx 16rpx;
  border-radius: 4rpx;
}

.tag.blue {
  color: #1989fa;
  background: #e6f7ff;
}

.info-card {
  background: #fff;
  margin: 20rpx 30rpx;
  border-radius: 16rpx;
  padding: 30rpx;
}

.info-row {
  display: flex;
  justify-content: space-between;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.info-row:last-child {
  border-bottom: none;
}

.info-label {
  font-size: 28rpx;
  color: #666;
}

.info-value {
  font-size: 28rpx;
  color: #333;
}

.info-value.highlight {
  color: #52c41a;
  font-weight: bold;
}

.info-value.price {
  color: #ff6b35;
  font-weight: bold;
}

.package-card {
  margin: 20rpx 30rpx;
  padding: 28rpx;
  border-radius: 18rpx;
  background: #fff;
  box-shadow: 0 8rpx 24rpx rgba(15, 23, 42, 0.05);
}

.package-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.package-title {
  color: #111827;
  font-size: 30rpx;
  font-weight: 700;
}

.package-subtitle {
  margin-top: 8rpx;
  color: #64748b;
  font-size: 24rpx;
}

.package-more {
  flex-shrink: 0;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  background: #eef4ff;
  color: #001f80;
  font-size: 24rpx;
}

.package-loading {
  padding: 36rpx 0;
  color: #94a3b8;
  font-size: 26rpx;
  text-align: center;
}

.package-product {
  display: flex;
  gap: 20rpx;
  padding: 22rpx 0;
  border-top: 1rpx solid #f0f3f8;
}

.package-product:first-of-type {
  border-top: none;
}

.package-product-main {
  flex: 1;
  min-width: 0;
}

.package-product-top {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.package-product-name {
  color: #111827;
  font-size: 29rpx;
  font-weight: 700;
}

.package-owned {
  flex-shrink: 0;
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  background: #e8f3ff;
  color: #1677ff;
  font-size: 22rpx;
}

.package-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 12rpx;
}

.package-tag {
  padding: 5rpx 12rpx;
  border-radius: 8rpx;
  background: #f1f5ff;
  color: #001f80;
  font-size: 22rpx;
}

.package-desc {
  display: block;
  margin-top: 12rpx;
  color: #64748b;
  font-size: 24rpx;
  line-height: 1.5;
}

.package-price-side {
  width: 150rpx;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  justify-content: center;
  flex-shrink: 0;
}

.package-price {
  color: #f97316;
  font-size: 28rpx;
  font-weight: 700;
  text-align: right;
}

.package-arrow {
  margin-top: 10rpx;
  color: #94a3b8;
  font-size: 40rpx;
}

.action-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  gap: 20rpx;
  padding: 20rpx 30rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: #fff;
  box-shadow: 0 -2rpx 10rpx rgba(0,0,0,0.05);
}

.btn {
  flex: 1;
  height: 88rpx;
  border-radius: 44rpx;
  font-size: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  margin: 0;
}

.btn-outline {
  background: #fff;
  color: #001f80;
  border: 2rpx solid #001f80;
}

.btn-primary {
  background: #001f80;
  color: #fff;
}

.notice-card {
  background: #fff;
  margin: 20rpx 30rpx;
  border-radius: 16rpx;
  padding: 30rpx;
}

.notice-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}

.notice-content {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.notice-content text {
  font-size: 26rpx;
  color: #666;
  line-height: 1.6;
}

.map-card {
  background: #fff;
  margin: 20rpx 30rpx;
  border-radius: 16rpx;
  padding: 30rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.map-card-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
}

.map-card-desc {
  margin-top: 10rpx;
  font-size: 25rpx;
  color: #777;
}

.map-card-arrow {
  font-size: 48rpx;
  color: #001f80;
}
