<view class="container">
  <navbar title="停车场详情" />

  <view class="header">
    <view class="parking-name">{{parkingInfo.name}}</view>
    <view class="parking-address">{{parkingInfo.address}}</view>
    <view class="parking-tags">
      <text class="tag" wx:if="{{parkingInfo.hasDiscount}}">有优惠</text>
      <text class="tag" wx:if="{{parkingInfo.is24Hour}}">24小时</text>
      <text class="tag blue" wx:if="{{parkingInfo.hasEV}}">新能源</text>
    </view>
  </view>

  <view class="info-card">
    <view class="info-row">
      <text class="info-label">总车位数</text>
      <text class="info-value">{{parkingInfo.totalSpaces}}个</text>
    </view>
    <view class="info-row">
      <text class="info-label">剩余车位</text>
      <text class="info-value highlight">{{parkingInfo.available}}个</text>
    </view>
    <view class="info-row">
      <text class="info-label">首小时价格</text>
      <text class="info-value price">¥{{parkingInfo.firstHourPrice}}</text>
    </view>
    <view class="info-row">
      <text class="info-label">超时价格</text>
      <text class="info-value">¥{{parkingInfo.overTimePrice}}/小时</text>
    </view>
  </view>

  <view class="action-bar">
    <button class="btn btn-outline" bindtap="openMap">导航到这</button>
    <button class="btn btn-primary" bindtap="startParking">我要停车</button>
  </view>

  <view class="notice-card">
    <view class="notice-title">停车须知</view>
    <view class="notice-content">
      <text>1. 请将车辆停放在规定车位内</text>
      <text>2. 离场时请出示停车凭证</text>
      <text>3. 如有疑问请联系客服</text>
    </view>
  </view>

  <view class="map-card" bindtap="goParkingMap">
    <view>
      <view class="map-card-title">查看停车分布图</view>
      <view class="map-card-desc">放大查看点位，支持导航到停车场</view>
    </view>
    <text class="map-card-arrow">›</text>
  </view>
</view>
