page {
  background-color: #fff;
  font-size: 28rpx;
  color: #333;
}

.container {
  padding: 0;
}

.btn-primary {
  background-color: #1989fa;
  color: #fff;
  border-radius: 8rpx;
  padding: 24rpx 48rpx;
  text-align: center;
  font-size: 32rpx;
}

.btn-secondary {
  background-color: #fff;
  color: #1989fa;
  border: 1px solid #1989fa;
  border-radius: 8rpx;
  padding: 24rpx 48rpx;
  text-align: center;
  font-size: 32rpx;
}

.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.08);
}
